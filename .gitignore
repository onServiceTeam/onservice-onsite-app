# Dependencies
node_modules/

# Environment
.env
.env.local
.env.production

# E07 — server-only secret: admin Basic Auth hash (generated on the box, never committed)
nginx/.htpasswd

# Tester handoff doc holds live staging credentials — never commit to the public repo.
TESTER-HANDOFF.md

# E07 — local dev env: untracked so a real secret can't be committed here.
# Provisioned from infra/docker/.env.docker.example by CI + scripts/dev/up.*
infra/docker/.env.docker

# Build outputs
dist/
build/
.expo/
*.tsbuildinfo

# Local upload backend (dev-only; production uses S3)
packages/api/uploads/

# OS files
.DS_Store
Thumbs.db

# IDE
# Per-developer .vscode/ files (launch.json, tasks.json, personal prefs) stay
# local. Only settings.json is re-included so workspace-shared config (e.g.,
# Claude Code extension defaults) propagates via the repo. Per Phase 14
# Dispatch 01 PR #6.
.vscode/*
!.vscode/settings.json
.idea/

# Claude Code local harness settings (per-machine, not part of project doctrine)
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# Evidence chain (governance) — these .log files are part of the audit trail
!.ai-coder/checkpoints/logs/**/*.log
# But exclude transient/timestamped run logs that get regenerated on every invocation
.ai-coder/checkpoints/logs/PHASE-*/verify-master-attempt-*.log
.ai-coder/checkpoints/logs/money-conservation-*.log

# Testing
coverage/

# Mobile
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/ios/Pods/
apps/mobile/ios/build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Docker
docker-compose.override.yml

# phase verify-run artifacts (regenerated each run)
# NOTE: HASHES.sha256 and BASELINE-DEBT.md are NOT gitignored — they are the
# audit trail's terminal artifacts and must be on origin so the evidence chain
# referenced by phase tag annotations resolves.
/.ai-coder/checkpoints/logs/PHASE-*/gates/
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl

# Server-local operational data — MUST NEVER be committed. These exist only on
# the production box: backups/ holds DB dumps + uploaded files (real user PII),
# certbot/ holds TLS private keys. Ignored so an accidental `git add -A` on the
# server can't leak secrets or personal data into the repo. The server
# bootstrap scripts are likewise server-local.
/backups/
/certbot/
/00-docker.sh
/02-deploy.sh

# Ad-hoc diagnostic scripts (one-off, may contain test creds) — never commit
/scripts/diag-*.sh

# Playwright run artifacts (admin visual suite)
apps/admin/test-results/

# Expo CNG native projects (generated by prebuild; never committed)
apps/mobile/android/
apps/mobile/ios/
