# =========================================
# onService Environment Variables
# Copy this file to .env and fill in values
# =========================================
# CUSTOM PORTS: 7381-7385 (IANA unassigned, no conflicts)
# API=7381 | Admin=7382 | PostgreSQL=7383 | PgBouncer=7384 | Redis=7385

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:7382
ADMIN_URL=http://localhost:7382
API_URL=http://localhost:7381
PORT=7381

# --- Database (PostgreSQL 17 + PostGIS 3.5, matching the supported dev stack) ---
DATABASE_URL=postgresql://onservice:onservice_dev@localhost:7383/onservice_dev
DATABASE_DIRECT_URL=postgresql://onservice:onservice_dev@localhost:7383/onservice_dev
DB_HOST=localhost
DB_PORT=7383
DB_NAME=onservice_dev
DB_USER=onservice
DB_PASSWORD=onservice_dev
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL_MODE=disable

# --- PgBouncer ---
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=7384

# --- Redis 8.6 ---
REDIS_URL=redis://localhost:7385
REDIS_HOST=localhost
REDIS_PORT=7385

# --- JWT ---
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Admin refresh JWTs/cookies use platformConfig.adminSessionTimeoutHours (8h).

# --- TOTP encryption (REQUIRED for admin 2FA) ---
# 64-char hex string = 32 bytes for AES-256-GCM. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BUG-PHASE23-01: setting this to a non-hex string crashes 2FA enrollment.
# The boot-time validator in totp.ts now throws clearly if format is wrong.
TOTP_ENCRYPTION_KEY=__GENERATE_64_HEX_CHARS__

# --- PayMongo (Philippine Payment Gateway) ---
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxxxxxxxxxxx
# E14 safety contract. Known-invalid external authorization code remains held
# even if this value is accidentally changed; keep 0 until replacement lands.
EXTERNAL_PAYMENT_AUTHORIZATION_ENABLED=0

# E22 safety contract. BIR document issuance awaits approved invoice design.
BIR_DOCUMENT_ISSUANCE_ENABLED=0

# E24 safety contract. Direct provider/customer dispute settlement is held;
# providers can still contest and staff can review the case.
DISPUTE_PARTY_SETTLEMENT_ENABLED=0

# Development fixtures are opt-in and must remain off on shared/live hosts.
ENABLE_TEST_FIXTURES=0

# --- Semaphore (Philippine SMS Gateway) ---
SEMAPHORE_API_KEY=xxxxxxxxxxxx
SEMAPHORE_SENDER_NAME=onService

# --- Dev / demo login bypass (LOCAL TESTING ONLY) ---
# When ALLOW_DEV_OTP=1 (and NODE_ENV is not "production"), the mobile login
# accepts the fixed code below for ANY phone, so you can log in as a seeded
# customer/provider without receiving a real SMS. This is triple-gated and is
# physically ignored when NODE_ENV=production. NEVER set ALLOW_DEV_OTP=1 in
# a production environment. See docs/TESTING-GUIDE.md.
ALLOW_DEV_OTP=1
DEV_OTP_CODE=000000

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=onservice-app
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- Optional S3-compatible upload backend ---
# Leave S3_BUCKET empty for the local filesystem backend. The Docker dev stack
# supplies its own MinIO credentials and endpoint.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-1
S3_CDN_URL=
S3_KMS_KEY_ID=
KYC_S3_BUCKET=
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:7381/uploads

# --- Email (Resend) ---
# Internal verification-code delivery only. This does NOT enable email login.
# Requires a real sending key and verified sender domain; no dev success bypass.
EMAIL_AUTH_DELIVERY_ENABLED=0
# Authenticated dual-proof linking only, not email login. Keep off until the
# complete sender/CAPTCHA/client journey and migration chain are accepted.
EMAIL_LINKING_ENABLED=0
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@onservice.ph

# --- OTP Config ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Cloudflare Turnstile (OTP lockout CAPTCHA) ---
# The public site key is also provided to mobile/web builds as
# EXPO_PUBLIC_TURNSTILE_SITE_KEY. The secret is server-only. Historical
# CAPTCHA_* aliases remain accepted by the API during deployment migration.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- CORS (Phase 13 Dispatch D) ---
# Comma-separated list of origins allowed by the API. Falls back to APP_URL,
# then localhost defaults if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7382

# --- Redis Authentication (Production) ---
REDIS_PASSWORD=

# --- Sentry Error Tracking ---
SENTRY_DSN=

# --- Monitoring (Grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- SSL / Domain ---
DOMAIN=api.onservice.ph
CERTBOT_EMAIL=admin@onservice.ph
