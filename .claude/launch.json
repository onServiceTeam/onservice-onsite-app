{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "api:dev"],
      "port": 3001
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "admin:dev"],
      "port": 7382
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "mobile:start"],
      "port": 8081
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--workspace=apps/mobile"],
      "port": 8081
    },
    {
      "name": "mobile-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-s", "apps/mobile/dist-web", "-l", "8090"],
      "port": 8090
    }
  ]
}
