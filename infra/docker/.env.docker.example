# Local Docker stack environment — TEMPLATE.
#
# E07 (2026-06-09): the real `infra/docker/.env.docker` is now gitignored so a
# real secret can never be committed here by accident. Copy this template to
# create it:
#
#   cp infra/docker/.env.docker.example infra/docker/.env.docker
#
# (CI and scripts/dev/up.* do this automatically.) Every value below is a
# LOCAL-ONLY dev default — safe to share. Production values live in a separate,
# untracked secrets file (`/opt/onservice/.env`, 600, gitignored) and are NOT
# any of these. Never put a real secret in .env.docker.

# --- Application ---
NODE_ENV=development

# --- Local demo/testing conveniences (LOCAL ONLY) ---
# Accept the fixed OTP "000000" for any phone so a tester can log into the
# mobile app without a real SMS. Triple-gated; ignored when NODE_ENV=production.
ALLOW_DEV_OTP=1
DEV_OTP_CODE=000000
# Enable the /__test fixture endpoints (force-error / seed empty|success).
ENABLE_TEST_FIXTURES=1

# --- Database (PostgreSQL 17 + PostGIS 3.5) ---
DB_USER=onservice
DB_PASSWORD=onservice_dev
DB_NAME=onservice_dev
DB_PORT=7383

# --- Redis 8 ---
REDIS_PORT=7385

# --- MinIO (S3-compatible) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- MailHog SMTP testing ---
SMTP_PORT=1025
SMTP_UI_PORT=8025

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
# Note: Grafana exposes 3001 on host because admin web app uses 3000 sometimes
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- API ---
API_PORT=7381

# --- JWT (dev-only secret) ---
# Generate a real secret for any non-local environment:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
JWT_SECRET=dev-only-change-me-not-for-production-use

# --- MMKV encryption key (dev-only fallback) ---
# In production, the key is derived from the OS keychain via
# expo-secure-store (Bug 1061 fix in D01). This dev fallback is used
# only when running the mobile app in jest/test/SSR contexts where
# the OS keychain is unavailable.
EXPO_PUBLIC_MMKV_KEY=dev-only-mmkv-key-change-in-prod
