# Admin web (Vite) environment example.
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# hCaptcha public site key (paired with HCAPTCHA_SECRET on the API).
# Get from https://dashboard.hcaptcha.com — different keys per env.
VITE_HCAPTCHA_SITE_KEY=

# API base URL the admin app talks to.
VITE_API_URL=http://localhost:7381
