# onService customer/provider app build variables
# Copy to apps/mobile/.env for local development. Keep native build values in
# a private local environment or the selected EAS environment, never in Git.

# Public API origin baked into the client bundle.
EXPO_PUBLIC_API_URL=http://localhost:7381

# Public Cloudflare Turnstile site key. The secret stays server-side.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Controlled demo mode is off by default. All four values are required together
# only for an explicitly authorized demo build.
EXPO_PUBLIC_DEMO_MODE=0
EXPO_PUBLIC_DEMO_CUSTOMER_PHONE=
EXPO_PUBLIC_DEMO_PROVIDER_PHONE=
EXPO_PUBLIC_DEMO_OTP=

# Tester builds only: set to 1 to show a small floating "Feedback" button on
# the customer and provider tab screens, plus a "Send feedback or report a
# problem" row on Help and provider Settings. They open
# app.onservice.ph/feedback with the screen, app version and app-or-browser
# filled in. Leave 0 for real customer builds: with 0 none of them appear.
EXPO_PUBLIC_TESTER_FEEDBACK=0

# Default native/EAS builds require both Maps keys and the EAS project identity.
# For the explicit LOCAL Android-only path set the selector to 1. It still
# requires a real Android Maps key, even during development-mode prebuild.
# EXPO_OS must be android or unset, and EAS_BUILD must not be true in that mode.
# No EAS identity means no configured Expo push/OTA. This selector does NOT
# supply signing, a safe API URL, release versioning, an APK or an updater.
ONSERVICE_ANDROID_STANDALONE=0
EAS_PROJECT_ID=
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
SENTRY_DSN_MOBILE=
