# ============================================================
# onService production/server environment inventory
# Copy to /opt/onservice/.env, keep mode 600, and replace every
# required placeholder before setting NODE_ENV=production.
# Never put mobile/public build variables or real values in Git.
# ============================================================

# --- App / server ---
NODE_ENV=production
PORT=7381
APP_VERSION=0.1.0
APP_URL=https://app.onservice.ph
ADMIN_URL=https://admin.onservice.ph
API_URL=https://api.onservice.ph
TRUST_PROXY_HOPS=1

# Dangerous test/bypass switches must remain zero on a public deployment.
ADMIN_DISABLE_2FA=0
ALLOW_DEV_OTP=0
DEV_OTP_CODE=
ENABLE_TEST_FIXTURES=0
RATE_LIMITS_RELAXED=0
BIR_DOCUMENT_ISSUANCE_ENABLED=0
EXTERNAL_PAYMENT_AUTHORIZATION_ENABLED=0
DISPUTE_PARTY_SETTLEMENT_ENABLED=0

# --- Domain / TLS ---
DOMAIN=onservice.ph
CERTBOT_EMAIL=admin@onservice.ph

# --- Database (PostgreSQL 17 + PostGIS 3.5 in docker-compose.prod.yml) ---
DATABASE_URL=postgresql://onservice_user:CHANGE_ME_STRONG_PASSWORD@pgbouncer:6432/onservice
DATABASE_DIRECT_URL=postgresql://onservice_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/onservice
DB_HOST=postgres
DB_PORT=5432
DB_NAME=onservice
DB_USER=onservice_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=20
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# The current self-hosted API -> PgBouncer hop is private inside the Compose
# network and PgBouncer has no client-TLS listener. Keep disable for this exact
# topology. Use verify-full for an external/managed database. `require` encrypts
# without CA/hostname verification and should be limited to a reviewed migration.
DB_SSL_MODE=disable
# Deprecated compatibility fallback. Leave blank when DB_SSL_MODE is set.
DB_SSL_REJECT_UNAUTHORIZED=

# --- Redis 8 ---
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Auth / JWT / admin TOTP ---
# Generate independent values; never reuse JWT_SECRET for the export secret.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTES
DATA_EXPORT_DOWNLOAD_SECRET=CHANGE_ME_GENERATE_INDEPENDENT_RANDOM_64_BYTES
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ADMIN_REFRESH_EXPIRES_IN=1h
# 32 bytes, encoded as exactly 64 hex characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_HEX_CHARACTERS

# --- PayMongo (blocked on E14 until a valid authorization flow is approved) ---
# Keep EXTERNAL_PAYMENT_AUTHORIZATION_ENABLED=0 above. Enabling it before the
# replacement flow passes test-mode end-to-end review would expose a known
# invalid checkout redirect and create stuck payment attempts.
PAYMONGO_PUBLIC_KEY=pk_live_XXXXX
PAYMONGO_SECRET_KEY=sk_live_XXXXX
PAYMONGO_WEBHOOK_SECRET=whsk_XXXXX
PAYMONGO_CHECKOUT_BASE=https://api.paymongo.com

# --- SMS (Semaphore) ---
SEMAPHORE_API_KEY=XXXXX
SEMAPHORE_SENDER_NAME=onService

# --- Cloudflare Turnstile ---
# Server secret only. The public site key belongs in apps/mobile/.env or EAS.
TURNSTILE_SECRET_KEY=

# --- Push notifications ---
FCM_PROJECT_ID=onservice-app
GOOGLE_APPLICATION_CREDENTIALS=/opt/onservice/secrets/firebase-service-account.json
EXPO_ACCESS_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=re_XXXXX
EMAIL_FROM=noreply@onservice.ph

# --- OTP and rate limits ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# --- Browser CORS allowlist ---
ALLOWED_ORIGINS=https://app.onservice.ph,https://admin.onservice.ph,https://www.onservice.ph,https://onservice.ph

# --- File upload (current production: external Docker volume) ---
# docker-compose.prod.yml forces S3_BUCKET empty and mounts the data-bearing
# onservice_uploads_data volume at /app/uploads. Leave S3 values empty unless a
# separately approved and tested object-storage migration is being deployed.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_CDN_URL=
S3_KMS_KEY_ID=
KYC_S3_BUCKET=
UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=https://api.onservice.ph/uploads

# --- BIR immutable archive (launch-cutover Item 8; not upload storage) ---
# E22 blocks the invoice pipeline contract. Leave empty until the accountant-
# approved document model and separately approved Object Lock backend exist.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Tester-feedback export and operational alerts ---
# Generate the export key independently; it protects private tester submissions.
FEEDBACK_EXPORT_KEY=CHANGE_ME_GENERATE_INDEPENDENT_RANDOM_64_BYTES
SLACK_ALERT_WEBHOOK_URL=

# --- Sentry ---
# Leave the DSN blank until a real production project exists. Placeholder DSNs
# still initialize the SDK and create misleading startup state.
SENTRY_API_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
