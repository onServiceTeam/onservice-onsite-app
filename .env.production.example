# ============================================================
# onService Production Environment Variables
# Copy to .env and fill in all values before deploying.
# ============================================================

# --- App / Server ---
NODE_ENV=production
PORT=7381
APP_URL=https://onservice.ph
ADMIN_URL=https://admin.onservice.ph
API_URL=https://api.onservice.ph

# --- Domain / SSL ---
DOMAIN=onservice.ph
CERTBOT_EMAIL=admin@onservice.ph

# --- Database (PostgreSQL 18) ---
DATABASE_URL=postgresql://user:password@localhost:5432/onservice
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/onservice
DB_HOST=postgres
DB_PORT=5432
DB_NAME=onservice
DB_USER=onservice_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- PgBouncer ---
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# --- Redis 8 ---
REDIS_URL=redis://:password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Auth / JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_BYTES
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
JWT_ADMIN_REFRESH_EXPIRES_IN=

# --- PayMongo (Philippine Payment Gateway) ---
# Get keys from https://dashboard.paymongo.com
PAYMONGO_PUBLIC_KEY=pk_live_XXXXX
PAYMONGO_SECRET_KEY=sk_live_XXXXX
PAYMONGO_WEBHOOK_SECRET=whsk_XXXXX
PAYMONGO_CHECKOUT_BASE=https://api.paymongo.com

# --- SMS (Semaphore) ---
# Philippine SMS gateway — https://semaphore.co
SEMAPHORE_API_KEY=XXXXX
SEMAPHORE_SENDER_NAME=onService

# --- Push Notifications ---
# Firebase Cloud Messaging
FCM_PROJECT_ID=onservice-app
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Expo push notifications (optional, for Expo push token delivery)
EXPO_ACCESS_TOKEN=

# --- File Upload (S3-compatible: AWS S3 or DigitalOcean Spaces) ---
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_BUCKET=onservice-uploads
S3_ACCESS_KEY_ID=XXXXX
S3_SECRET_ACCESS_KEY=XXXXX
S3_REGION=sgp1
S3_CDN_URL=https://onservice-uploads.sgp1.cdn.digitaloceanspaces.com
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=http://localhost:7381/uploads

# --- Email (Resend) ---
RESEND_API_KEY=re_XXXXX
EMAIL_FROM=noreply@onservice.ph

# --- OTP Configuration (override platform.config.ts defaults) ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# --- Security ---
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=
# 32-byte hex key for AES-256-GCM encryption of admin TOTP secrets at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# --- CORS allowlist (Phase 13 Dispatch D) ---
ALLOWED_ORIGINS=https://admin.onservice.ph,https://www.onservice.ph

# --- hCaptcha (Phase 13 Dispatch D) ---
HCAPTCHA_SECRET=

# --- Monitoring ---
SENTRY_DSN=https://XXXXX@sentry.io/XXXXX

# --- Grafana (used by docker-compose.prod.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
