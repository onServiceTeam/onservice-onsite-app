{
  "name": "onservice-onsite-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "onService Philippine Home Services Marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace=packages/api",
    "api:build": "npm run build --workspace=packages/api",
    "api:test": "npm run test --workspace=packages/api",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "mobile:android": "npm run android --workspace=apps/mobile",
    "mobile:ios": "npm run ios --workspace=apps/mobile",
    "admin:dev": "npm run dev --workspace=apps/admin",
    "admin:build": "npm run build --workspace=apps/admin",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "loadtest:smoke": "k6 run load-tests/full-suite.js -e PROFILE=smoke",
    "loadtest:load": "k6 run load-tests/full-suite.js -e PROFILE=load",
    "loadtest:stress": "k6 run load-tests/full-suite.js -e PROFILE=stress",
    "loadtest:soak": "k6 run load-tests/full-suite.js -e PROFILE=soak",
    "loadtest:auth": "k6 run load-tests/scenarios/auth.js -e PROFILE=load",
    "loadtest:bookings": "k6 run load-tests/scenarios/booking-flow.js -e PROFILE=load",
    "loadtest:catalog": "k6 run load-tests/scenarios/catalog-search.js -e PROFILE=load",
    "loadtest:payments": "k6 run load-tests/scenarios/payment-webhook.js -e PROFILE=load"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1"
  }
}
